{
  "disciplines": [
    {
      "id": "opt",
      "name": "SLSQP",
      "type": "driver",
      "inputs": [
        "cd",
        "cl",
        "area",
        "smoothness_upper",
        "smoothness_lower"
      ],
      "outputs": [
        "cst_upper",
        "cst_lower",
        "alpha"
      ]
    },
    {
      "id": "geometry",
      "name": "CST geometry",
      "type": "explicit",
      "inputs": [
        "cst_upper",
        "cst_lower"
      ],
      "outputs": [
        "x",
        "smoothness_upper",
        "smoothness_lower"
      ]
    },
    {
      "id": "area_comp",
      "name": "AirfoilArea",
      "type": "explicit",
      "inputs": [
        "x"
      ],
      "outputs": [
        "area"
      ]
    },
    {
      "id": "analysis",
      "name": "Analysis",
      "type": "explicit",
      "inputs": [
        "x",
        "alpha",
        "Re",
        "Ma"
      ],
      "outputs": [
        "cl",
        "cd",
        "cm"
      ]
    }
  ],
  "connections": [
    {
      "source": "opt.cst_upper",
      "sink": "geometry.cst_upper"
    },
    {
      "source": "opt.cst_lower",
      "sink": "geometry.cst_lower"
    },
    {
      "source": "opt.alpha",
      "sink": "analysis.alpha"
    },
    {
      "source": "geometry.x",
      "sink": [
        "area_comp.x",
        "analysis.x"
      ]
    },
    {
      "source": "geometry.smoothness_upper",
      "sink": "opt.smoothness_upper"
    },
    {
      "source": "geometry.smoothness_lower",
      "sink": "opt.smoothness_lower"
    },
    {
      "source": "area_comp.area",
      "sink": "opt.area"
    },
    {
      "source": "analysis.cl",
      "sink": "opt.cl"
    },
    {
      "source": "analysis.cd",
      "sink": "opt.cd"
    }
  ]
}
